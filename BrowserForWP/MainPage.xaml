<Page
    x:Class="BrowserForWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrowserForWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Single root: layout grid plus overlay as siblings inside one Grid. -->
    <Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{ThemeResource TextControlBackground}"
                        CornerRadius="4" Padding="4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SecurityGlyph" FontSize="14"
                                   VerticalAlignment="Center" Margin="4,0"
                                   Text="&#x26A0;"/>
                        <TextBox x:Name="AddressBox" BorderThickness="0" Width="260"
                                 VerticalAlignment="Center"
                                 InputScope="Url"
                                 AcceptsReturn="False"
                                 KeyDown="AddressBox_KeyDown"
                                 GotFocus="AddressBox_GotFocus"
                                 LostFocus="AddressBox_LostFocus"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="1" x:Name="GoButton"
                        Click="GoButton_Click" Margin="6,0,0,0"/>
            </Grid>

            <ProgressBar Grid.Row="1" x:Name="LoadProgress" Height="3"
                         IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"/>

            <Border Grid.Row="2" x:Name="ContentHost"/>

            <TextBlock Grid.Row="3" x:Name="ErrorText" TextWrapping="Wrap"
                       Margin="8,2" Opacity="0.9" Visibility="Collapsed"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8">
                <Button x:Name="BackButton" Click="BackButton_Click" Margin="0,0,6,0"/>
                <Button x:Name="ForwardButton" Click="ForwardButton_Click" Margin="0,0,6,0"/>
                <Button x:Name="ReloadButton" Click="ReloadButton_Click" Margin="0,0,6,0"/>
                <Button x:Name="StopButton" Click="StopButton_Click" Margin="0,0,6,0"/>
                <Button x:Name="TabsButton" Click="TabsButton_Click" Margin="0,0,6,0"/>
                <Button x:Name="SecurityDetailsButton" Click="SecurityDetailsButton_Click" Margin="0,0,6,0"/>
                <Button x:Name="SettingsButton" Click="SettingsButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="SettingsOverlay" Visibility="Collapsed"
              Background="#CC000000">
            <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Padding="16" Margin="24" CornerRadius="8"
                    VerticalAlignment="Center">
                <ScrollViewer MaxHeight="520">
                <StackPanel>
                    <TextBlock x:Name="SettingsTitle" FontSize="24" Margin="0,0,0,12"/>

                    <TextBlock x:Name="LanguageLabel" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LanguagePicker" Width="280"
                              SelectionChanged="LanguagePicker_SelectionChanged"/>

                    <CheckBox x:Name="DesktopToggle" Margin="0,8,0,0"
                              Checked="DesktopToggle_Checked"
                              Unchecked="DesktopToggle_Unchecked"/>

                    <TextBlock x:Name="HomepageLabel" Margin="0,8,0,4"/>
                    <TextBox x:Name="HomepageBox" Width="280" InputScope="Url"
                             LostFocus="HomepageBox_LostFocus"/>
                    <TextBlock x:Name="SearchEngineLabel" Margin="0,8,0,4"/>
                    <ComboBox x:Name="SearchEnginePicker" Width="280"
                              SelectionChanged="SearchEnginePicker_SelectionChanged"/>

                    <TextBlock x:Name="TabsTitle" FontSize="18" Margin="0,16,0,4"/>
                    <ListBox x:Name="TabsList" Height="80" Width="280"
                             SelectionChanged="TabsList_SelectionChanged"/>
                    <Button x:Name="CloseTabButton" Margin="0,4,0,0"
                            Click="CloseTabButton_Click"/>

                    <TextBlock x:Name="HistoryTitle" FontSize="18" Margin="0,12,0,4"/>
                    <ListBox x:Name="HistoryList" Height="80" Width="280"
                             SelectionChanged="HistoryList_SelectionChanged"/>
                    <Button x:Name="ClearHistoryButton" Margin="0,4,0,0"
                            Click="ClearHistoryButton_Click"/>

                    <TextBlock x:Name="FavoritesTitle" FontSize="18" Margin="0,12,0,4"/>
                    <ListBox x:Name="FavoritesList" Height="80" Width="280"
                             SelectionChanged="FavoritesList_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddFavoriteButton" Margin="0,4,6,0"
                                Click="AddFavoriteButton_Click"/>
                        <Button x:Name="RemoveFavoriteButton" Margin="0,4,0,0"
                                Click="RemoveFavoriteButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="DiagnosticsTitle" FontSize="18" Margin="0,16,0,4"/>
                    <TextBlock x:Name="EngineText" TextWrapping="Wrap" Margin="0,0,0,8"
                               Opacity="0.8"/>

                    <Button x:Name="CompatProbeButton" Margin="0,0,0,6"
                            Click="CompatProbeButton_Click"/>
                    <TextBlock x:Name="CompatProbeResult" TextWrapping="Wrap"
                               Opacity="0.8" Margin="0,0,0,8"/>

                    <TextBlock x:Name="TlsProbeHostLabel" Margin="0,0,0,4"/>
                    <TextBox x:Name="TlsHostBox" Width="280" InputScope="Url"/>
                    <Button x:Name="TlsProbeButton" Margin="0,4,0,6"
                            Click="TlsProbeButton_Click"/>
                    <TextBlock x:Name="TlsProbeResult" TextWrapping="Wrap"
                               Opacity="0.8" Margin="0,0,0,8"/>

                    <TextBlock x:Name="DohServerLabel" Margin="0,0,0,4"/>
                    <TextBox x:Name="DohServerBox" Width="280" InputScope="Url"
                             LostFocus="DohServerBox_LostFocus"/>

                    <TextBlock x:Name="PinTitle" FontSize="18" Margin="0,12,0,4"/>
                    <TextBox x:Name="PinHostBox" Width="280" InputScope="Url"/>
                    <TextBox x:Name="PinValueBox" Width="280" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PinAddButton" Margin="0,4,6,0"
                                Click="PinAddButton_Click"/>
                        <Button x:Name="PinRemoveButton" Margin="0,4,0,0"
                                Click="PinRemoveButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PinStatus" TextWrapping="Wrap"
                               Opacity="0.8" Margin="0,4,0,8"/>

                    <Button x:Name="CloseSettingsButton" Click="CloseSettingsButton_Click"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Page>
